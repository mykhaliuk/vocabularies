{
  "name": "vocabu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:local": "bun run infra:up && node scripts/with-env.js local nuxt dev",
    "infra:up": "docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "start:dev": "node scripts/with-env.js dev nuxt dev",
    "start:preprod": "node scripts/with-env.js preprod nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint app.vue error.vue assets components composables db layouts middleware pages plugins scripts server shared utils *.config.js",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "nuxt typecheck",
    "ds:check": "node scripts/ds-check.js",
    "proto:check": "node scripts/proto-check.js",
    "proto:pull": "node scripts/proto-pull.js",
    "proto:update": "node scripts/proto-pull.js && node scripts/proto-check.js",
    "ds:verify": "node scripts/ds-check.js && node scripts/proto-check.js",
    "ds:pull": "node scripts/ds-pull.js",
    "ds:sync": "node scripts/ds-sync.js",
    "ds:update": "node scripts/ds-pull.js && node scripts/ds-sync.js && node scripts/ds-check.js",
    "db:generate": "node scripts/with-env.js local drizzle-kit generate",
    "db:migrate": "node scripts/with-env.js local drizzle-kit migrate",
    "db:migrate:dev": "node scripts/with-env.js dev drizzle-kit migrate",
    "db:migrate:preprod": "node scripts/with-env.js preprod drizzle-kit migrate",
    "db:dump:dev": "node scripts/with-env.js dev node scripts/db-dump-dev.js",
    "r2:cors:dev": "node scripts/with-env.js dev node scripts/r2-cors-set.js",
    "r2:cors:preprod": "node scripts/with-env.js preprod node scripts/r2-cors-set.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@neondatabase/serverless": "^0.10.0",
    "@sentry/nuxt": "^9.0.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "@vite-pwa/nuxt": "^0.10.0",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.0",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^5.0.0",
    "nuxt": "^4.0.0",
    "pg": "^8.13.0",
    "resend": "^6.12.2",
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^0.13.0",
    "typescript": "^5.6.0",
    "vue-tsc": "^3.2.7"
  }
}
