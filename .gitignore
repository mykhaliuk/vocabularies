# build output
dist/
.output/

# scratch / local artifacts
tmp/

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# nuxt
.nuxt/
.data/

# dependencies
node_modules/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# environment variables — a pattern rather than a list of stages. The list
# had to be edited every time a stage appeared or went away, and the moment a
# retired stage's line was removed its leftover local file (full of cloud
# credentials) became committable. Only the template is tracked.
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# downloaded Claude Design bundles (ingested via ds:pull / proto:pull)
*.zip

# jetbrains setting folder
.idea/
*/skills/metaskills
.vercel

# claude code project config — track skills + shared settings (overrides a
# global ignore of .claude/), but never commit worktrees or local settings
!.claude/
.claude/worktrees/
.claude/settings.local.json

# Fonts vendored out of node_modules on postinstall (VKB-124, ADR-0019).
# Generated from the pinned @fontsource-variable packages, so the lockfile is
# the record — committing the binaries would be a second one that can drift.
public/fonts/
