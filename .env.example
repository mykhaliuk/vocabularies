# ============================================================
# Vocabu — environment template
# Copy to .env.local / .env.dev and fill values.
# All .env.* files are gitignored. Never commit secrets.
# ============================================================

# --- App ---
APP_ENV=local                          # local | dev | production
APP_URL=http://localhost:3000          # production: https://vocabu.myka.me

# --- Database (Postgres: Neon in cloud, Docker locally) ---
DB_DRIVER=pg                           # pg | neon
# Pooled URL: used by app at runtime (serverless-friendly).
DATABASE_URL=
# Direct URL: used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=
# The deploy-time migration gate reads these two: it refuses to build a
# production deploy with no database, or one where only the pooled URL is
# set, rather than shipping un-migrated code on a green build (ADR-0017).
# SKIP_MIGRATIONS=1 declares a database-less build on purpose; leave it
# unset everywhere else.

# --- Object storage (S3-compatible: MinIO locally, R2 in cloud) ---
# Two buckets per stage (VKB-63): media = derivatives + posters + avatars
# (served to the app); originals = private ingest of raw uploads (presigned
# PUT + transcoder only, never served).
S3_ENDPOINT=                           # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto                         # R2: auto. MinIO: any value (e.g. us-east-1)
S3_BUCKET_MEDIA=                       # vocabu-media-<stage>, or -local for MinIO
S3_BUCKET_ORIGINALS=                   # vocabu-originals-<stage>, or -local for MinIO
S3_FORCE_PATH_STYLE=true               # required for MinIO; safe for R2

# One scoped credential per bucket (VKB-126) — never the same key for both,
# and no fallback between them: a media key must not reach private ingest.
# In R2 that means "Object Read & Write" with the bucket list narrowed to the
# one bucket; "apply to all buckets" hands back the account-wide key this
# split exists to retire.
#
# Scope by STAGE as well as by role — four application tokens, one per cell:
#
#              dev              prod
#   media      media-dev        media-prod
#   originals  originals-dev    originals-prod
#
# The stage axis is what bounds a leak: dev credentials sit in Vercel Preview,
# in .env.dev on a laptop and in local run logs, while the prod buckets hold
# the recordings people cannot re-make.
#
# The prod pair belongs in Vercel Production and NOWHERE else. There is no
# .env.prod on purpose: with-env.js reads .env.<stage> from the working
# directory, so such a file would make the most valuable key the easiest one
# to copy.
S3_MEDIA_ACCESS_KEY_ID=
S3_MEDIA_SECRET_ACCESS_KEY=
S3_ORIGINALS_ACCESS_KEY_ID=
S3_ORIGINALS_SECRET_ACCESS_KEY=

# Admin-scoped pair, ops scripts only (`bun run r2:cors:*`) — needs r2:cors:*,
# which the two application pairs above deliberately lack. Not read by the
# app, so it never goes into Vercel. One token covers every stage: R2 grants
# "Admin Read & Write" account-wide rather than per bucket.
S3_ADMIN_ACCESS_KEY_ID=
S3_ADMIN_SECRET_ACCESS_KEY=

# --- Media processing queue (QStash; inline fallback locally) ---
# Final transport per ADR-0009 (VKB-80). Token + signing keys are
# account-level; the named queue isolates stages.
# QSTASH_URL is the regional REST endpoint (our account is EU:
# https://qstash-eu-central-1.upstash.io); the SDK reads it from the
# environment automatically. Also points at `qstash-cli dev` locally.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_QUEUE_NAME=                     # dev: vocabu-stage | prod: vocabu

# --- Email (Resend; bypassed locally) ---
RESEND_API_KEY=
EMAIL_FROM=                            # dev: onboarding@resend.dev | prod: auth@vocabu.myka.me
# The sandbox sender only delivers to the account owner's address, so nothing
# exercises real delivery — DNS, DKIM, spam placement — before production.
# VKB-173 moves dev onto the verified sender; until it lands, that gap is
# known rather than waiting to be discovered.

# --- Rate limiting (Upstash Redis REST; disabled locally) ---
# Two Upstash DBs: `vocabu-stage` (dev), `vocabu` (prod);
# APP_ENV still namespaces keys within an instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required on every configured stage: a build that carries a database but no
# Upstash pair is refused, rather than running with abuse control silently at
# zero (ADR-0018). SKIP_RATELIMIT_GATE=1 declares the omission on purpose.

# --- Cron auth (Vercel Cron → /api/cron/*; optional locally) ---
# Random string. Vercel sends it as `Authorization: Bearer <secret>` on cron
# invocations. Required on every non-local stage (probe fails closed without
# it). Generate with: openssl rand -base64 24
CRON_SECRET=

# --- Auth ---
# 48-byte base64 random. Generate with: openssl rand -base64 48
# MUST differ per environment. Never reuse, never commit.
JWT_SECRET=

# --- Monitoring (Sentry; one DSN across all envs) ---
SENTRY_DSN=
# Source-map upload at deploy build (set in Vercel env only — never commit the
# token). All three required to upload; absent → upload skipped.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
